{
  "schema_version": 2,
  "project_id": "aidp-ai-data-governance",
  "terraform": {
    "path": "terraform",
    "package_oci_credentials": false
  },
  "capabilities": {
    "compartment_modes": [
      "new",
      "existing"
    ],
    "default_compartment_name": "aidp-governance",
    "requires_genai_region": true,
    "database_profile": "new_or_existing",
    "region_selection": "subscribed_compatible",
    "regional_requirements": [
      "aidp",
      "genai_chat"
    ],
    "existing_database_wallet": "none"
  },
  "presentation": {
    "title": "AIDP AI Data Governance",
    "summary": "Deploys two documentation and governance agents, eighteen catalog tables and a four-task workflow in Oracle AI Data Platform. Creates or reuses an Autonomous AI Lakehouse 26ai for managed agent memory and lets you select the agent model in Deploy Studio.",
    "image": "/assets/oci-aidp-cloud-migration-lab.png",
    "image_alt": "AIDP AI Data Governance on AI Data Platform Workbench; data, analytics and artificial intelligence illustration.",
    "tags": [
      "AIDP",
      "Governance",
      "LangGraph",
      "Master Catalog"
    ],
    "href": "https://github.com/jgangini/aidp-ai-data-gobernance"
  },
  "run_steps": [
    {
      "key": "queue",
      "label": "Queued"
    },
    {
      "key": "credentials",
      "label": "Validate identity and access"
    },
    {
      "key": "plan",
      "label": "Review resources"
    },
    {
      "key": "apply",
      "label": "Prepare platform and artifacts"
    },
    {
      "key": "artifacts",
      "label": "Install and verify resources"
    },
    {
      "key": "complete",
      "label": "TEST candidate installed"
    }
  ],
  "form": {
    "fields": [
      {
        "name": "aidp_mode",
        "label": "Services mode",
        "type": "select",
        "required": true,
        "default": "new",
        "options": [
          {
            "value": "new",
            "label": "Create new AIDP"
          },
          {
            "value": "existing",
            "label": "Use existing AIDP"
          }
        ],
        "group": "aidp_platform",
        "span": 1
      },
      {
        "name": "new_aidp_name",
        "label": "New AIDP name",
        "type": "text",
        "required": true,
        "default": "aidp_governance",
        "min_length": 1,
        "max_length": 255,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]{0,254}$",
        "span": 1,
        "group": "aidp_platform",
        "visible_when": {
          "field": "aidp_mode",
          "equals": "new"
        }
      },
      {
        "name": "existing_ai_data_platform_ocid",
        "label": "Existing AIDP",
        "type": "select",
        "options_source": "oci_aidp_platforms",
        "required": true,
        "visible_when": {
          "field": "aidp_mode",
          "equals": "existing"
        },
        "pattern": "^ocid1\\.aidataplatform\\..+$",
        "group": "aidp_platform"
      },
      {
        "name": "existing_workspace_key",
        "label": "Existing workspace",
        "type": "select",
        "required": true,
        "visible_when": {
          "field": "aidp_mode",
          "equals": "existing"
        },
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "group": "aidp_platform",
        "options_source": "oci_aidp_workspaces"
      },
      {
        "name": "identity_domain_id",
        "label": "Identity Domain",
        "type": "select",
        "required": true,
        "options_source": "oci_identity_domains",
        "pattern": "^ocid1\\.domain\\..+$",
        "group": "identity"
      },
      {
        "name": "admin_user_ocid",
        "label": "AIDP administrator",
        "type": "select",
        "required": true,
        "options_source": "oci_aidp_administrators",
        "group": "identity"
      },
      {
        "name": "artifacts_mode",
        "label": "Artifacts bucket mode",
        "type": "select",
        "required": true,
        "default": "existing",
        "options": [
          {
            "value": "new",
            "label": "Create new bucket"
          },
          {
            "value": "existing",
            "label": "Use existing bucket"
          }
        ],
        "group": "artifacts"
      },
      {
        "name": "artifacts_bucket_name",
        "label": "New artifacts bucket name",
        "type": "text",
        "required": true,
        "pattern": "^[A-Za-z0-9._-]{1,128}$",
        "min_length": 1,
        "max_length": 128,
        "group": "artifacts",
        "visible_when": {
          "field": "artifacts_mode",
          "equals": "new"
        }
      },
      {
        "name": "artifacts_existing_bucket_name",
        "label": "Existing artifacts bucket",
        "type": "select",
        "options_source": "oci_active_buckets",
        "required": true,
        "visible_when": {
          "field": "artifacts_mode",
          "equals": "existing"
        },
        "pattern": "^[A-Za-z0-9._-]{1,128}$",
        "min_length": 1,
        "max_length": 128,
        "group": "artifacts"
      },
      {
        "name": "model_id",
        "label": "Select Model",
        "type": "select",
        "required": true,
        "default": "xai.grok-4.7",
        "options_source": "oci_genai_chat_models",
        "group": "enterprise_ai"
      },
      {
        "name": "autonomous_database_mode",
        "label": "Database mode",
        "type": "select",
        "required": true,
        "default": "new",
        "options": [
          {
            "value": "new",
            "label": "Create new database"
          },
          {
            "value": "existing",
            "label": "Use existing database"
          }
        ],
        "group": "database"
      },
      {
        "name": "autonomous_database_version",
        "label": "Database profile",
        "type": "select",
        "required": true,
        "default": "26ai:DW",
        "transform": "database_profile",
        "options": [
          {
            "value": "26ai:DW",
            "label": "Oracle AI Database 26ai · AI Lakehouse (DW)"
          }
        ],
        "visible_when": {
          "field": "autonomous_database_mode",
          "equals": "new"
        },
        "group": "database"
      },
      {
        "name": "existing_autonomous_database_ocid",
        "label": "Existing Autonomous Database",
        "type": "select",
        "required": true,
        "pattern": "^ocid1\\.autonomousdatabase\\..+$",
        "visible_when": {
          "field": "autonomous_database_mode",
          "equals": "existing"
        },
        "group": "database",
        "options_source": "oci_autonomous_databases"
      },
      {
        "name": "autonomous_database_admin_password",
        "label": "Database admin password",
        "type": "password",
        "required": false,
        "secret": true,
        "min_length": 12,
        "max_length": 30,
        "group": "database",
        "generate_password": true,
        "generate_password_when": {
          "field": "autonomous_database_mode",
          "equals": "new"
        }
      }
    ],
    "groups": [
      {
        "id": "credentials",
        "title": "OCI credentials",
        "items": [
          {
            "kind": "control",
            "name": "oci_config",
            "label": "OCI config"
          },
          {
            "kind": "control",
            "name": "oci_key",
            "label": "API private key"
          }
        ]
      },
      {
        "id": "services",
        "title": "Services to deploy",
        "items": [
          {
            "kind": "control",
            "name": "oci_region",
            "label": "OCI Region",
            "span": 2
          },
          {
            "kind": "control",
            "name": "compartment_mode",
            "label": "Compartment mode",
            "options": [
              {
                "value": "new",
                "label": "New compartment"
              },
              {
                "value": "existing",
                "label": "Existing compartment"
              }
            ]
          },
          {
            "kind": "control",
            "name": "new_compartment",
            "label": "New compartment name"
          },
          {
            "kind": "control",
            "name": "existing_compartment",
            "label": "Existing compartment"
          }
        ]
      },
      {
        "id": "identity",
        "title": "Identity",
        "items": [
          {
            "kind": "field",
            "name": "identity_domain_id",
            "span": 1
          },
          {
            "kind": "field",
            "name": "admin_user_ocid",
            "span": 1
          }
        ]
      },
      {
        "id": "aidp_platform",
        "title": "AI Data Platform Workbench",
        "items": [
          {
            "kind": "field",
            "name": "aidp_mode",
            "span": 1
          },
          {
            "kind": "field",
            "name": "new_aidp_name",
            "span": 1
          },
          {
            "kind": "field",
            "name": "existing_ai_data_platform_ocid",
            "span": 1
          },
          {
            "kind": "field",
            "name": "existing_workspace_key",
            "span": 1
          }
        ]
      },
      {
        "id": "enterprise_ai",
        "title": "AI Data Platform Workbench Agent Flow",
        "items": [
          {
            "kind": "field",
            "name": "model_id",
            "span": 1
          }
        ]
      },
      {
        "id": "artifacts",
        "title": "Artifacts",
        "items": [
          {
            "kind": "field",
            "name": "artifacts_mode",
            "span": 1
          },
          {
            "kind": "field",
            "name": "artifacts_bucket_name",
            "span": 1
          },
          {
            "kind": "field",
            "name": "artifacts_existing_bucket_name",
            "span": 1
          }
        ]
      },
      {
        "id": "database",
        "title": "Oracle AI Database",
        "items": [
          {
            "kind": "field",
            "name": "autonomous_database_mode",
            "span": 1
          },
          {
            "kind": "field",
            "name": "autonomous_database_version",
            "span": 1
          },
          {
            "kind": "field",
            "name": "existing_autonomous_database_ocid",
            "span": 1
          },
          {
            "kind": "field",
            "name": "autonomous_database_admin_password",
            "span": 1
          }
        ]
      }
    ]
  },
  "outputs": [
    "ai_data_platform_ocid",
    "workspace_key",
    "workspace_name",
    "aidp_mode",
    "artifacts_bucket_name",
    "artifacts_mode",
    "objectstorage_namespace",
    "compartment_ocid",
    "region",
    "identity_domain_id",
    "admin_user_ocid",
    "model_id",
    "resource_ownership",
    "autonomous_database_id",
    "autonomous_database_mode",
    "memory_status",
    "governance_status",
    "validation_stage",
    "operation_id",
    "outcome_status",
    "failed_operation_id",
    "failed_operation_type"
  ],
  "artifacts": [],
  "preflight": {
    "entrypoint": "terraform/m_preflight.py",
    "timeout_seconds": 300,
    "requires_oci_credentials": true,
    "secret_inputs": [
      "autonomous_database_admin_password"
    ],
    "output_inputs": [
      "home_region",
      "artifacts_bucket_name"
    ],
    "runtime_fields": [
      {
        "name": "home_region",
        "label": "Tenancy home region",
        "type": "text",
        "required": true,
        "pattern": "^[a-z]{2}-[a-z0-9-]+-[0-9]+$"
      }
    ]
  },
  "post_apply": {
    "entrypoint": "terraform/hooks/post_apply.py",
    "include_paths": [
      "src/ai_data_governance",
      "requirements.txt"
    ],
    "timeout_seconds": 3600,
    "requires_oci_credentials": true,
    "secret_inputs": [
      "autonomous_database_admin_password"
    ]
  }
}
